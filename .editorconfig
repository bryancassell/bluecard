# https://editorconfig.org/
# Shared formatting settings, read by both ktlint (via Spotless) and
# Android Studio, so the IDE formatter and the build agree.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Follow Android's Kotlin style guide:
# https://developer.android.com/kotlin/style-guide
ktlint_code_style = android_studio
max_line_length = 100

# Keep Android Studio's formatter compatible with ktlint:
# https://ktlint.github.io/ktlint/latest/rules/configuration-intellij-idea/
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
# Never use wildcard imports (the style guide does not allow them).
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset

# Compose functions are named like types (PascalCase), which ktlint's
# function-naming rule otherwise rejects.
ktlint_function_naming_ignore_when_annotated_with = Composable
