.idea/*
!.idea/runConfigurations/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Signing keys
*.jks
*.keystore

# Build outputs
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Kotlin
.kotlin/
