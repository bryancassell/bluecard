        <item quantity="one">%1$d completed</item>
        <item quantity="other">%1$d completed</item>
    </plurals>
    <plurals name="home_in_progress">
        <item quantity="one">%1$d in progress</item>
        <item quantity="other">%1$d in progress</item>
    </plurals>
    <!-- What screen readers say for the trail of ranks on Home's rank card, such as "2 of 7 ranks
         earned". The quantity is the number of ranks. -->
    <plurals name="home_ranks_earned">
        <item quantity="one">%1$d of %2$d rank earned</item>
        <item quantity="other">%1$d of %2$d ranks earned</item>
    </plurals>
    <!-- The quantity is the number completed. -->
    <plurals name="home_eagle_completed">
        <item quantity="one">%1$d of %2$d completed</item>
        <item quantity="other">%1$d of %2$d completed</item>
    </plurals>
    <!-- How many badges the Badges list shows: every badge, or the ones that match the search.
         Screen readers announce it when it changes. -->
    <plurals name="badges_count">
        <item quantity="one">%1$d merit badge</item>
        <item quantity="other">%1$d merit badges</item>
    </plurals>
    <!-- On the row of a requirement that isn't complete yet, how many of the sub-requirements it
         needs are, such as "(1 of 3 complete)". The quantity is the number complete. -->
    <plurals name="requirement_complete_count">
        <item quantity="one">(%1$d of %2$d complete)</item>
        <item quantity="other">(%1$d of %2$d complete)</item>
    </plurals>
    <!-- requirement_choice and requirement_complete_count on one line, such as
         "Do 2 of 3 (1 of 2 complete)": 2 of its 3 sub-requirements are needed, and 1 of those 2
         is complete. The quantity is the number complete. -->
    <plurals name="requirement_choice_and_complete_count">
        <item quantity="one">Do %1$d of %2$d (%3$d of %4$d complete)</item>
        <item quantity="other">Do %1$d of %2$d (%3$d of %4$d complete)</item>
    </plurals>
    <!-- Under the summary on the page of a rank's requirement that asks for time in the rank
         below, such as "Eligible from Jan 1, 2027, 4 months after earning First Class": the
         date the scout becomes eligible to complete it, the months it asks for, and the rank
         below. The quantity is the months. -->
    <plurals name="requirement_time_in_rank_eligible_from">
        <item quantity="one">Eligible from %1$s, %2$d month after earning %3$s</item>
        <item quantity="other">Eligible from %1$s, %2$d months after earning %3$s</item>
    </plurals>
    <!-- The same while the rank below isn't earned, such as "Eligible 4 months after earning
         First Class, which isn't earned yet". The quantity is the months. -->
    <plurals name="requirement_time_in_rank_not_earned">
        <item quantity="one">Eligible %1$d month after earning %2$s, which isn\'t earned yet</item>
        <item quantity="other">Eligible %1$d months after earning %2$s, which isn\'t earned yet</item>
    </plurals>
    <!-- The same while the rank below is earned with no date, such as when it only counts as
         earned with a rank above it: "Eligible 4 months after earning First Class, which has no
         date it was earned on". The quantity is the months. -->
    <plurals name="requirement_time_in_rank_no_date">
        <item quantity="one">Eligible %1$d month after earning %2$s, which has no date it was earned on</item>
        <item quantity="other">Eligible %1$d months after earning %2$s, which has no date it was earned on</item>
    </plurals>
    <!-- How many merit badges the scout has completed, against the number a rank's requirement
         asks for, such as "4 of 6 merit badges". The quantity is the number it asks for. -->
    <plurals name="requirement_merit_badges_count">
        <item quantity="one">%1$d of %2$d merit badge</item>
        <item quantity="other">%1$d of %2$d merit badges</item>
    </plurals>
    <!-- How many of the scout's merit badges count as Eagle-required, against the number a
         rank's requirement asks for, such as "2 of 4 Eagle-required". The quantity is the
         number it asks for. -->
    <plurals name="requirement_eagle_required_count">
        <item quantity="one">%1$d of %2$d Eagle-required</item>
        <item quantity="other">%1$d of %2$d Eagle-required</item>
    </plurals>
    <!-- On the page of a rank's requirement that asks for merit badges, how many more the scout
         needs, when any badge will do, such as "Needs 2 more merit badges". The quantity is the
         number needed. -->
    <plurals name="requirement_merit_badges_needed">
        <item quantity="one">Needs %1$d more merit badge</item>
        <item quantity="other">Needs %1$d more merit badges</item>
    </plurals>
    <!-- The same when every one of them must be Eagle-required, such as "Needs 2 more
         Eagle-required merit badges". The quantity is the number needed. -->
    <plurals name="requirement_eagle_required_badges_needed">
        <item quantity="one">Needs %1$d more Eagle-required merit badge</item>
        <item quantity="other">Needs %1$d more Eagle-required merit badges</item>
    </plurals>
    <!-- The same when only some of them must be Eagle-required, such as "Needs 3 more merit
         badges, 1 of them Eagle-required": the number needed, then how many of them must be
         Eagle-required, which is always fewer. The quantity is the number needed. -->
    <plurals name="requirement_merit_badges_needed_some_eagle_required">
        <item quantity="one">Needs %1$d more merit badge, %2$d of them Eagle-required</item>
        <item quantity="other">Needs %1$d more merit badges, %2$d of them Eagle-required</item>
    </plurals>
    <!-- Heading of the list of merit badges the scout has completed, on the page of a rank's
         requirement that asks for merit badges. -->
    <string name="requirement_merit_badges_title">Merit badges</string>
    <!-- Under a badge's name in that list: the date the scout completed it on, such as
         "Completed on Apr 15, 2026". -->
    <string name="requirement_merit_badge_completed_on">Completed on %1$s</string>
    <!-- The same for a badge completed with no date. -->
    <string name="requirement_merit_badge_completed">Completed</string>
    <!-- At the end of a badge's row in that list, when it counts as one of the Eagle-required
         badges the requirement asks for. Of the badges in an Eagle "one of" group, only one
         counts. -->
    <string name="requirement_merit_badge_eagle_required">Eagle-required</string>
</resources>
