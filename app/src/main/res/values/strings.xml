<resources>
    <string name="app_name">BlueCard</string>
    <!-- The language of these strings, as a BCP 47 tag, such as "en". Lists and numbers inside
         a string, such as the badges in an Eagle group, are formatted in this language, and
         plurals follow its rules, so a sentence never mixes two. Each translation sets its
         own, as a well-formed tag for its folder's language ("pt-BR", not "pt_BR"). -->
    <string name="strings_language">en</string>
    <!-- Shown in place of a screen when the data stored on the phone can't be read. -->
    <string name="load_failed">Couldn\'t load your data. Try closing and reopening BlueCard.</string>
    <!-- Shown briefly when something the scout recorded couldn't be saved on the phone. -->
    <string name="save_failed">Couldn\'t save. Try again.</string>
    <!-- A dialog shown once, when the progress stored on the phone was damaged and BlueCard
         started over without it. The name and unit number are stored apart, so they're kept. -->
    <string name="damaged_progress_title">Your progress couldn\'t be read</string>
    <string name="damaged_progress_message">The progress saved on this phone was damaged, so BlueCard started over without it. Your name and unit number are kept. If you exported your progress, you can import it from Data management.</string>
    <string name="damaged_progress_ok">OK</string>
    <string name="onboarding_title">Welcome to BlueCard</string>
    <string name="onboarding_message">Enter your name and unit number to get started.</string>
    <string name="profile_name">Name</string>
    <string name="profile_unit_number">Unit number</string>
    <string name="profile_required">Required</string>
    <string name="onboarding_save">Get started</string>
    <string name="onboarding_save_failed">Couldn\'t save. Try again.</string>
    <string name="home_unit">Unit: %1$s</string>
    <string name="home_no_progress">You haven\'t started any merit badges yet.</string>
    <string name="home_badges_title">Your merit badges</string>
    <string name="home_eagle_title">Eagle-required</string>
    <string name="home_open_badges">Merit badges</string>
    <string name="home_open_data_management">Manage data</string>
    <string name="badges_title">Merit badges</string>
    <string name="badges_eagle_required">Eagle-required</string>
    <!-- An Eagle-required badge that is one of a group of alternatives. %1$s lists the group's
         badges in the strings_language, such as "Cycling, Hiking, and Swimming". -->
    <string name="badges_eagle_required_one_of">Eagle-required (one of %1$s)</string>
    <string name="badges_in_progress">In progress</string>
    <string name="badges_completed">Completed</string>
    <!-- What screen readers say about a badge in progress's progress bar: "40% done". -->
    <string name="badges_percent_done">%1$d%% done</string>
    <!-- Screen reader action on a badge in the list: "Double tap to open badge". -->
    <string name="badges_open_badge">open badge</string>
    <string name="badges_search">Search merit badges</string>
    <!-- Screen reader label for the button that empties the search field. -->
    <string name="badges_clear_search">Clear search</string>
    <string name="badges_no_matches">No merit badges match your search.</string>
    <string name="badge_detail_official_page">Official requirements</string>
    <string name="badge_detail_requirements">Requirements</string>
    <!-- Shown when tapping the official requirements link, if no app on the phone can open
         web links. -->
    <string name="badge_detail_no_browser">No app on this phone can open the link.</string>
    <!-- Screen reader action on the official requirements link, which opens the badge's
         official page in the browser: "Double tap to open in browser". -->
    <string name="badge_detail_open_in_browser">open in browser</string>
    <!-- Heading of the section of a badge's page about the scout's merit badge counselor. -->
    <string name="badge_detail_counselor">Counselor</string>
    <string name="badge_detail_add_counselor">Add counselor</string>
    <string name="badge_detail_edit_counselor">Edit counselor</string>
    <!-- Screen reader action on the counselor's phone number, which opens the phone app with
         the number: "Double tap to call". -->
    <string name="badge_detail_call_counselor">call</string>
    <!-- Screen reader action on the counselor's email address, which opens an email app:
         "Double tap to send email". -->
    <string name="badge_detail_email_counselor">send email</string>
    <!-- Shown when tapping the counselor's phone number, if no app on the phone can make
         calls. -->
    <string name="badge_detail_no_phone_app">No app on this phone can call the number.</string>
    <!-- Shown when tapping the counselor's email address, if no app on the phone can send
         email. -->
    <string name="badge_detail_no_email_app">No app on this phone can send email.</string>
    <!-- Heading of the page for entering the badge's merit badge counselor. -->
    <string name="edit_counselor_title">Counselor</string>
    <string name="edit_counselor_name">Name</string>
    <string name="edit_counselor_phone">Phone</string>
    <string name="edit_counselor_email">Email</string>
    <string name="edit_counselor_save">Save</string>
    <string name="edit_profile_title">Name and unit</string>
    <string name="edit_profile_save">Save</string>
    <!-- Shown in place of a badge's page when the catalog doesn't have the badge or its
         requirements version. Only a catalog edited during development can cause this. -->
    <string name="requirements_unavailable">This badge\'s requirements aren\'t in this version of BlueCard.</string>
    <!-- A requirement where only some of its sub-requirements are needed, such as "Do 2 of 3". -->
    <string name="requirement_choice">Do %1$d of %2$d</string>
    <string name="requirement_completed">Completed</string>
    <!-- Screen readers read it as the state of a requirement's row while nothing of it is
         complete, then read "In progress" or "Completed". -->
    <string name="requirement_not_completed">Not completed</string>
    <!-- Screen readers read it as the state of a requirement's row once part of it is complete,
         such as one of its sub-requirements, until it's complete. -->
    <string name="requirement_in_progress">In progress</string>
    <!-- On the row and page of a requirement that isn't complete but no longer needs to be,
         because a requirement it's part of is complete, such as a choice the scout didn't pick.
         Screen readers read it as the row's state. -->
    <string name="requirement_not_needed">Not needed</string>
    <!-- On a badge the scout marked completed on a prior date, without recording its
         requirements: in its report, and read by screen readers as the state of a requirement's
         row, in place of "Not completed". -->
    <string name="requirement_not_recorded">Not recorded</string>
    <!-- Screen reader action on a requirement's row, which opens its own page: "Double tap to
         open requirement". -->
    <string name="requirement_open">open requirement</string>
    <!-- The date a requirement was completed on, such as "Completed on Apr 15, 2026". -->
    <string name="requirement_completed_on">Completed on %1$s</string>
    <!-- Shown for a completed requirement that has no completion date. -->
    <string name="requirement_no_date">No completion date</string>
    <string name="requirement_add_date">Add date</string>
    <string name="requirement_change_date">Change date</string>
    <string name="requirement_remove_date">Remove date</string>
    <!-- For screen readers, a date's button with the label of the date it's for, then the
         button's text, such as "Start: Add date" in a tracker row. -->
    <string name="labeled_date_button">%1$s: %2$s</string>
    <!-- Label of the field for the scout's notes about a requirement. -->
    <string name="requirement_comment">Notes</string>
    <string name="requirement_save_comment">Save notes</string>
    <!-- Button that closes a dialog asking to confirm removing something, such as a tracker
         row, without removing it. -->
    <string name="confirm_dialog_cancel">Cancel</string>
    <!-- Asks before Back closes a page whose fields have changes that aren't saved, and the
         dialog's button that discards them and closes the page. -->
    <string name="discard_changes_title">Discard changes?</string>
    <string name="discard_changes_message">Your changes haven\'t been saved.</string>
    <!-- The same, on a requirement's page, where the checkbox and date save straight away and
         only the notes wait for their Save button. -->
    <string name="discard_changes_message_notes">Your changes to the notes haven\'t been saved.</string>
    <string name="discard_changes_confirm">Discard</string>
    <!-- Buttons of the dialog for picking a requirement's completion date. -->
    <string name="date_picker_ok">OK</string>
    <string name="date_picker_cancel">Cancel</string>
    <!-- Heading of a requirement's page, with its official number, such as "Requirement 4b". -->
    <string name="requirement_detail_title">Requirement %1$s</string>
    <!-- Shown in place of a requirement's page when the requirements the badge or rank uses
         don't have it, such as after the badge or rank moves to another version. -->
    <string name="requirement_detail_unavailable">This requirement isn\'t in the requirements this badge or rank uses.</string>
    <!-- Button at the bottom of a badge's or a requirement's page, which asks before clearing
         what the scout recorded for it, and the dialog's button that clears it, which Clear
         all's dialog on Data management uses too. -->
    <string name="clear_progress">Clear progress</string>
    <string name="clear_progress_confirm">Clear</string>
    <!-- Asks before a badge's progress is cleared, with its name, such as "Clear progress on
         Camping?" -->
    <string name="badge_detail_clear_title">Clear progress on %1$s?</string>
    <string name="badge_detail_clear_message">What you recorded for it will be removed.</string>
    <!-- In place of the one above when the scout has entered the badge's counselor. -->
    <string name="badge_detail_clear_message_with_counselor">What you recorded for it will be removed, including its counselor.</string>
    <!-- Asks before a requirement's progress is cleared, with its official number, such as
         "Clear progress on requirement 4b?" -->
    <string name="requirement_clear_title">Clear progress on requirement %1$s?</string>
    <string name="requirement_clear_message">What you recorded for it will be removed.</string>
    <!-- For a requirement with sub-requirements, such as 4a and 4b under 4. -->
    <string name="requirement_clear_message_with_children">What you recorded for it and the requirements under it will be removed.</string>
    <!-- In place of the two above when the scout has changed the requirement's notes without
         saving them. -->
    <string name="requirement_clear_message_with_unsaved_notes">What you recorded for it will be removed, along with unsaved changes to its notes.</string>
    <string name="requirement_clear_message_with_children_and_unsaved_notes">What you recorded for it and the requirements under it will be removed, along with unsaved changes to its notes.</string>
    <!-- How much of a requirement's tracker is filled in, when the scout adds any number of
         rows to it, such as "5 sessions". What a row is called comes from the catalog. -->
    <string name="tracker_count">%1$d %2$s</string>
    <!-- How much of a requirement's tracker is filled in, when it has a fixed number of rows,
         such as "8 of 12 weeks". What a row is called comes from the catalog. -->
    <string name="tracker_count_of">%1$d of %2$d %3$s</string>
    <!-- Title of a row of a tracker, with what a row is called and its number, such as
         "Week 3" or "Session 12". -->
    <string name="tracker_row_title">%1$s %2$d</string>
    <!-- Button that adds a row to a tracker, with what a row is called, such as
         "Add session". -->
    <string name="tracker_add_row">Add %1$s</string>
    <!-- Screen reader action on a tracker row, which opens it to fill in or change: "Double tap
         to edit". -->
    <string name="tracker_edit_row">edit</string>
    <!-- Shown for a date in a tracker row that the scout hasn't given. -->
    <string name="tracker_entry_no_date">No date</string>
    <string name="tracker_entry_save">Save</string>
    <string name="tracker_entry_delete">Delete</string>
    <!-- Asks before a tracker row is deleted, with what a row is called, such as "Delete this
         session?" -->
    <string name="tracker_entry_delete_title">Delete this %1$s?</string>
    <string name="tracker_entry_delete_message">What you entered in it will be removed.</string>
    <!-- Shown in place of a tracker row's page when the requirements the badge or rank uses
         don't have the tracker or the row, such as after the row was deleted. -->
    <string name="tracker_entry_unavailable">This entry isn\'t in the tracker anymore.</string>
    <string name="data_management_title">Data management</string>
    <string name="data_management_profile_heading">Name and unit</string>
    <string name="data_management_profile_description">Change your name or unit number.</string>
    <string name="data_management_profile_edit">Edit</string>
    <!-- Export saves the scout's name, unit number and all their progress to a file they
         choose; import replaces all of it with what's in a file they exported. -->
    <string name="data_management_export_heading">Export data</string>
    <string name="data_management_export_description">Save your name, unit number and all your progress to a file.</string>
    <string name="data_management_export">Export</string>
    <string name="data_management_import_heading">Import data</string>
    <string name="data_management_import_description">Replace everything on this phone with a file you exported.</string>
    <string name="data_management_import">Import</string>
    <!-- Shown when tapping Import, if no app on the phone can open files. -->
    <string name="data_management_no_file_opener">No app on this phone can open files.</string>
    <!-- The name the file picker suggests for an export, without its ".json" extension, with
         the date in YYYY-MM-DD form, such as "BlueCard export 2026-10-01". -->
    <string name="export_file_name">BlueCard export %1$s</string>
    <!-- Asks before an import replaces everything, once the file is checked. -->
    <string name="import_confirm_title">Replace all your data?</string>
    <string name="import_confirm_message">Your name, unit number and all your progress will be replaced with the file\'s.</string>
    <string name="import_confirm">Replace</string>
    <!-- Shown briefly after an export or import, or when one couldn't be done. -->
    <string name="export_failed">Couldn\'t export. Try again.</string>
    <string name="import_read_failed">Couldn\'t open the file. Try again.</string>
    <string name="import_invalid">This file isn\'t a BlueCard export.</string>
    <string name="import_newer_format">This file is from a newer version of BlueCard. Update the app to import it.</string>
    <string name="import_failed">Couldn\'t import. Try again.</string>
    <string name="import_done">Data imported.</string>
    <!-- Clears the progress on every badge, including counselors, once the scout confirms.
         Their name and unit number stay. -->
    <string name="data_management_clear_heading">Clear all progress</string>
    <string name="data_management_clear_description">Remove the progress on every badge, including counselors. Your name and unit number stay.</string>
    <string name="data_management_clear">Clear all</string>
    <string name="clear_all_confirm_title">Clear all progress?</string>
    <string name="clear_all_confirm_message">The progress on every badge will be removed, including counselors. Your name and unit number stay.</string>
    <!-- Shown briefly after clearing all progress. -->
    <string name="clear_all_done">Progress cleared.</string>
    <!-- Button on a badge's page, while it isn't complete, that asks for a date and marks the
         badge completed on it without recording its requirements, as for a badge earned before
         using BlueCard. -->
    <string name="badge_detail_mark_completed">Mark completed</string>
    <!-- The date a badge was marked completed on, such as "Completed on Apr 15, 2025". -->
    <string name="badge_detail_completed_on">Completed on %1$s</string>
    <!-- Button under the date a badge was marked completed on, which undoes the mark. -->
    <string name="badge_detail_unmark_completed">Unmark</string>
    <!-- Buttons on a completed badge's page, for its report: a PDF of everything the scout
         recorded for it. Share opens Android's share sheet; Save asks where to save it. -->
    <string name="badge_detail_share_report">Share report</string>
    <string name="badge_detail_save_report">Save report</string>
    <!-- Shown when tapping Save report or Export, if no app on the phone can save files. -->
    <string name="no_file_saver">No app on this phone can save files.</string>
    <!-- Shown briefly when a badge's report couldn't be created or saved. -->
    <string name="report_failed">Couldn\'t create the report. Try again.</string>
    <!-- The report's file name, without its ".pdf" extension, with the badge's name, such as
         "Camping merit badge report". -->
    <string name="report_file_name">%1$s merit badge report</string>
    <!-- The rest of these are printed in the report, a PDF of everything the scout recorded
         for a badge, to give to their counselor or keep. -->
    <!-- Above the badge's name, at the top of the first page. -->
    <string name="report_kind">Merit badge report</string>
    <string name="report_scout">Scout: %1$s</string>
    <string name="report_unit">Unit: %1$s</string>
    <!-- The effective date of the requirements the scout worked on, such as "Requirements
         effective Jan 1, 2026". -->
    <string name="report_requirements_version">Requirements effective %1$s</string>
    <!-- The day the report was made, such as "Created on Sep 30, 2026". -->
    <string name="report_created_on">Created on %1$s</string>
    <!-- When the badge or a requirement was completed, such as "Completed on Apr 15, 2026". -->
    <string name="report_completed_on">Completed on %1$s</string>
    <!-- For a badge or requirement that's complete but has no completion date. -->
    <string name="report_completed">Completed</string>
    <string name="report_not_completed">Not completed</string>
    <!-- Heading of the merit badge counselor's details. -->
    <string name="report_counselor">Counselor</string>
    <string name="report_counselor_name">Name</string>
    <string name="report_counselor_phone">Phone</string>
    <string name="report_counselor_email">Email</string>
    <string name="report_requirements">Requirements</string>
    <!-- A requirement's official number and our summary of it, such as "4b. Cook a meal." -->
    <string name="report_requirement">%1$s. %2$s</string>
    <!-- Label of the scout's notes about a requirement, as on its page. -->
    <string name="report_comment">Notes</string>
    <!-- A label and its value, such as "Phone: 555-0100" or, in a tracker row,
         "Minutes: 30". -->
    <string name="report_labeled_value">%1$s: %2$s</string>
    <!-- At the foot of each page, such as "Page 1 of 3". -->
    <string name="report_page">Page %1$d of %2$d</string>
    <plurals name="home_completed">
        <item quantity="one">%1$d completed</item>
        <item quantity="other">%1$d completed</item>
    </plurals>
    <plurals name="home_in_progress">
        <item quantity="one">%1$d in progress</item>
        <item quantity="other">%1$d in progress</item>
    </plurals>
    <!-- The quantity is the number completed. -->
    <plurals name="home_eagle_completed">
        <item quantity="one">%1$d of %2$d completed</item>
        <item quantity="other">%1$d of %2$d completed</item>
    </plurals>
    <!-- How many badges the Badges list shows: every badge, or the ones that match the search.
         Screen readers announce it when it changes. -->
    <plurals name="badges_count">
        <item quantity="one">%1$d merit badge</item>
        <item quantity="other">%1$d merit badges</item>
    </plurals>
    <!-- On the row of a requirement that isn't complete yet, how many of the sub-requirements it
         needs are, such as "(1 of 3 complete)". The quantity is the number complete. -->
    <plurals name="requirement_complete_count">
        <item quantity="one">(%1$d of %2$d complete)</item>
        <item quantity="other">(%1$d of %2$d complete)</item>
    </plurals>
    <!-- requirement_choice and requirement_complete_count on one line, such as
         "Do 2 of 3 (1 of 2 complete)": 2 of its 3 sub-requirements are needed, and 1 of those 2
         is complete. The quantity is the number complete. -->
    <plurals name="requirement_choice_and_complete_count">
        <item quantity="one">Do %1$d of %2$d (%3$d of %4$d complete)</item>
        <item quantity="other">Do %1$d of %2$d (%3$d of %4$d complete)</item>
    </plurals>
</resources>
