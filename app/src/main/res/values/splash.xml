<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        MainActivity's launch theme: the splash screen, from androidx core-splashscreen so
        it looks the same on Android 8 to 11 as on 12+. installSplashScreen() switches to
        postSplashScreenTheme. Its background is set, not left to follow dark mode, so it
        matches the app's. Its system bar icons are dark to show on that background, as
        MainActivity keeps them once the app draws. Android 8.0 can't make the navigation
        bar's icons dark, so there they stay white until the app draws (ARCHITECTURE.md).
    -->
    <style name="Theme.BlueCard.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.BlueCard</item>
    </style>
</resources>
