<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 12 and higher: <cloud-backup> for Google Drive
    backups, <device-transfer> for moving to a new phone directly. Android 11 and
    lower use backup_rules.xml instead; keep the two files' rules the same.

    Only the scout's data is backed up: the Room database (with its write-ahead
    log files) and the DataStore files. The cache directory, where PDF reports
    are generated, is never backed up, so it needs no rule.
    https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
