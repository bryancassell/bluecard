<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 12 and higher: <cloud-backup> for Google Drive
    backups, <device-transfer> for moving to a new phone directly. Android 11 and
    lower use backup_rules.xml instead; keep the two files' rules the same
    (BackupRulesTest checks this).

    Only the scout's data is backed up: the databases directory, which holds the
    Room database and its write-ahead log files, and the DataStore directory,
    which holds the profile. The cache directory, where PDF reports are
    generated, is never backed up, so it needs no rule.
    https://developer.android.com/identity/data/autobackup

    Cloud backup isn't limited to phones that can encrypt it end to end
    (disableIfNoEncryptionCapabilities), so every scout who keeps backup on can
    move their records.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
